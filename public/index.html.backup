  <script>
    const ambient = document.getElementById("ambient");
    const revealPanel = document.querySelector(".reveal-panel");
    const particleCount = 24;
    for (let index = 0; index < particleCount; index += 1) {
      const dust = document.createElement("span");
      const size = 4 + Math.random() * 8;
      const left = Math.random() * 100;
    const duration = 14 + Math.random() * 14;  
      const delay = Math.random() * -18;
      const drift = `${-50 + Math.random() * 100}px`;

      dust.className = "dust";
      dust.style.left = `${left}%`;
      dust.style.width = `${size}px`;
      dust.style.height = `${size}px`;
      dust.style.animationDuration = `${duration}s`;
      dust.style.animationDelay = `${delay}s`;
      dust.style.setProperty("--drift-x", drift);
      ambient.appendChild(dust);
    }

    if (revealPanel) {
      const panDuration = 24000;

      const animateRevealPanel = (timestamp) => {
        const cycleProgress = (timestamp % panDuration) / panDuration;
        const oscillation = (Math.sin(cycleProgress * Math.PI * 2 - Math.PI / 2) + 1) / 2;
        const verticalPosition = oscillation * 100;

        revealPanel.style.backgroundPosition = `center center, center center, center ${verticalPosition}%`;
        window.requestAnimationFrame(animateRevealPanel);
      };

      window.requestAnimationFrame(animateRevealPanel);
    }
  </script>
    <script src="video-autoplay.js"></script>
