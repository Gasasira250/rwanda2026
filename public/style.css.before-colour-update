/* Consistent gold glow for major headings */
.gold-glow {
  color: #d9b45a;
  text-shadow:
    0 0 6px rgba(217, 180, 90, 0.45),
    0 0 14px rgba(217, 180, 90, 0.3);
  animation: goldHeadingGlow 3s ease-in-out infinite alternate;
}

@keyframes goldHeadingGlow {
  from {
    text-shadow:
      0 0 5px rgba(217, 180, 90, 0.35),
      0 0 10px rgba(217, 180, 90, 0.2);
  }

  to {
    text-shadow:
      0 0 10px rgba(217, 180, 90, 0.75),
      0 0 22px rgba(217, 180, 90, 0.45);
  }
}



/* =========================================================
   HOMEPAGE OFFERINGS CAROUSEL
   ========================================================= */

.home-carousel {
  position: relative;
  width: 100%;
  padding: 34px clamp(20px, 4vw, 44px) 40px;
  overflow: hidden;
}

.carousel-track {
  display: flex;
  width: 100%;
  transition: transform 450ms ease;
}

.carousel-slide {
  position: relative;
  flex: 0 0 100%;
  min-height: 360px;
  display: grid;
  grid-template-columns: 55% 45%;
  align-items: stretch;
  overflow: hidden;
  border-radius: 24px;
  text-decoration: none;
  color: inherit;
  background: rgba(10, 63, 100, 0.9);
  box-shadow: 0 18px 38px rgba(0, 47, 82, 0.28);
}

.carousel-image {
  position: relative;
  min-height: 360px;
  overflow: hidden;
  background: #0d5f9f;
}

.carousel-image video,
.carousel-image img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 360px;
  object-fit: cover;
}

.carousel-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40px;
  background:
    linear-gradient(
      135deg,
      rgba(13, 95, 159, 0.98),
      rgba(8, 66, 109, 0.94)
    );
}

.carousel-copy h2 {
  margin: 0 0 18px;
  color: #ffffff;
  font-family: "Khemenu", sans-serif;
  font-size: clamp(1.4rem, 3vw, 2.3rem);
  line-height: 1.05;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.carousel-copy p {
  margin: 0;
  color: #ffffff;
  font-family: "Stilu", sans-serif;
  font-size: 1.05rem;
  line-height: 1.5;
}



/* Carousel buttons */
.carousel-button {
  position: absolute;
  top: 50%;
  z-index: 5;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
  cursor: pointer;
  background: rgba(3, 45, 73, 0.78);
  color: #ffffff;
  font-size: 1.8rem;
  line-height: 1;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
}

.carousel-button:hover,
.carousel-button:focus-visible {
  background: rgba(3, 45, 73, 0.95);
  outline: 2px solid #d9b45a;
  outline-offset: 2px;
}

.carousel-prev {
  left: 28px;
}

.carousel-next {
  right: 28px;
}

/* Carousel dots */
.carousel-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  margin-top: 18px;
}

.carousel-dot {
  width: 10px;
  height: 10px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  cursor: pointer;
}

.carousel-dot.active,
.carousel-dot:hover {
  background: #d9b45a;
}

/* Prevent old homepage light-blue panels from appearing */
.home-carousel ~ .long-panels {
  display: none;
}

/* Desktop */
@media (min-width: 901px) {
  .carousel-slide {
    min-height: 420px;
  }

  .carousel-image,
  .carousel-image video,
  .carousel-image img {
    min-height: 420px;
  }
}

/* Tablet */
@media (max-width: 900px) {
  .carousel-slide {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .carousel-image {
    min-height: 280px;
  }

  .carousel-image video,
  .carousel-image img {
    min-height: 280px;
  }

  .carousel-copy {
    padding: 28px;
  }

  .carousel-prev {
    left: 28px;
  }

  .carousel-next {
    right: 28px;
  }
}

/* Mobile */
@media (max-width: 620px) {
  .home-carousel {
    padding: 26px 16px 30px;
  }

  .carousel-slide {
    border-radius: 18px;
  }

  .carousel-image {
    min-height: 220px;
  }

  .carousel-image video,
  .carousel-image img {
    min-height: 220px;
  }

  .carousel-copy {
    padding: 24px 22px 28px;
  }

  .carousel-copy h2 {
    font-size: 1.35rem;
  }

  .carousel-copy p {
    font-size: 0.95rem;
  }

  .carousel-button {
    width: 38px;
    height: 38px;
    font-size: 1.4rem;
  }

  .carousel-prev {
    left: 22px;
  }

  .carousel-next {
    right: 22px;
  }
}


/* =========================================================
   FOUNDER SECTION
   ========================================================= */

.founder-section {
  width: min(1200px, calc(100% - 40px));
  margin: 50px auto;
  padding: 40px;
  display: grid;
  grid-template-columns: 35% 65%;
  gap: 40px;
  align-items: stretch;
  border-radius: 24px;
