  flex-direction: column;
  justify-content: center;
}

.founder-kicker {
  margin: 0 0 10px;
  color: #d9b45a;
  font-family: "Stilu", sans-serif;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.founder-content h2 {
  margin: 0 0 18px;
  color: #ffffff;
  font-family: "Khemenu", sans-serif;
  font-size: clamp(1.8rem, 4vw, 3rem);
  text-transform: uppercase;
}

.founder-bio {
  margin: 0 0 28px;
  color: #ffffff;
  font-family: "Stilu", sans-serif;
  font-size: 1.05rem;
  line-height: 1.6;
}

.founder-details {
  display: grid;
  gap: 20px;
}

.founder-detail {
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.founder-detail h3 {
  margin: 0 0 7px;
  color: #d9b45a;
  font-family: "Khemenu", sans-serif;
  font-size: 1.1rem;
  text-transform: uppercase;
}

.founder-detail p {
  margin: 0;
  color: #ffffff;
  font-family: "Stilu", sans-serif;
  line-height: 1.5;
}

@media (max-width: 800px) {
  .founder-section {
    grid-template-columns: 1fr;
    padding: 25px;
    gap: 25px;
  }

  .founder-image-placeholder {
    min-height: 280px;
  }
}




/* =========================================================
   EXPANDED HOMEPAGE FOOTER
   ========================================================= */

.footer-main {
  display: block;
  width: min(1200px, calc(100% - 40px));
  margin: 0 auto;
  padding: 50px 0 24px;
}

.footer-newsletter {
  display: grid;
  grid-template-columns: 1fr minmax(320px, 460px);
  gap: 35px;
  align-items: center;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.footer-kicker {
  margin: 0 0 8px;
  color: #d9b45a;
  font-size: 0.8rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.footer-section-heading h2,
.footer-column h2 {
  margin: 0 0 12px;
  color: #ffffff;
  font-family: "Khemenu", sans-serif;
  text-transform: uppercase;
}

.footer-section-heading p,
.footer-column p {
  margin: 0;
  color: #dcefff;
  line-height: 1.5;
}

.newsletter-form {
  display: flex;
  gap: 10px;
}

.newsletter-form input {
  flex: 1;
  min-width: 0;
  padding: 14px 16px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font: inherit;
}

.newsletter-form input::placeholder {
  color: rgba(255, 255, 255, 0.7);
}

.newsletter-form button,
.footer-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 18px;
  border: 0;
  border-radius: 8px;
  background: #d9b45a;
  color: #17364d;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
}

.footer-columns {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 45px;
  padding: 40px 0;
}

.footer-column nav {
  display: grid;
  gap: 8px;
}

.footer-column nav a,
.footer-social-link {
  color: #dcefff;
  text-decoration: none;
  transition: color 180ms ease;
}

.footer-column nav a:hover,
.footer-column nav a:focus-visible,
.footer-social-link:hover,
.footer-social-link:focus-visible {
  color: #d9b45a;
}

.footer-social-links {
  display: grid;
  gap: 10px;
}

.footer-placeholder-note {
  margin-top: 16px !important;
  font-size: 0.78rem;
  opacity: 0.7;
}

.footer-credit {
  padding-top: 22px;
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 800px) {

  .footer-newsletter {
    grid-template-columns: 1fr;
  }

  .newsletter-form {
    flex-direction: column;
  }

  .footer-columns {
    grid-template-columns: 1fr;
    gap: 30px;
  }

}


