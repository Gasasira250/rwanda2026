  box-shadow: 0 18px 38px rgba(0, 47, 82, 0.22);
}

.founder-image-placeholder {
  min-height: 360px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18px;
  background:
    linear-gradient(
      135deg,
      #0d5f9f,
      #08426d
    );
